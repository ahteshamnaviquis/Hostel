# ---------------------------------------------------------------
# Hostel Management System - Backend environment variables
# Copy this file to ".env" and adjust the values for your machine.
# NEVER commit the real .env file.
# ---------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
APP_NAME=Hostel Management System

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hostel_management
DB_CONNECTION_LIMIT=10

# Timezone used by the MySQL session (Pakistan Standard Time)
DB_TIMEZONE=+05:00

# JWT (used from CHUNK 2 - change to a long random string)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
